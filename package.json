{
  "name": "quant-agent-e2e",
  "private": true,
  "version": "0.1.0-preview.2",
  "type": "module",
  "description": "T12 端到端测试（Playwright）。前端应用依赖在 web/ 下；这里只装 E2E 运行时。",
  "scripts": {
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:report": "playwright show-report tests/e2e/.artifacts/html",
    "i18n:check": "node scripts/qa-i18n.cjs",
    "qa:research": "node scripts/qa-research-coverage.cjs",
    "qa:mermaid": "node --experimental-strip-types scripts/qa-mermaid.mjs",
    "shots": "node scripts/qa-shots.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
