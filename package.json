{
  "name": "dsh-quantlab",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：QuantLab 量化研究台（本地后端 + 原平台界面 + DSH 模型桥 + 量化工具，含股票市场）。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./config.defaults.json": "./config.defaults.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "config.defaults.json",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
