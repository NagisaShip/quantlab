# 复制为 .env 后修改。不要把 .env 提交到仓库。
POSTGRES_USER=qagent
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=qagent
QAGENT_PORT=8000

# worker 并发与资源
QAGENT_WORKER_SLOTS=2
QAGENT_WORKER_CPUS=2.0
QAGENT_WORKER_MEMORY=4g
QAGENT_WORKER_MAX_RESIDENT=50
# 单个 Python 策略子进程上限
QAGENT_SANDBOX_CPU_SECONDS=300
QAGENT_SANDBOX_MEMORY_MB=1536

# 租约（毫秒）：worker 失联超过该时间，任务进入 RECOVERING 由其他 worker 接管
QAGENT_LEASE_MS=60000
# 实时模拟拉行情间隔（秒）
QAGENT_PAPER_TICK_SECONDS=30
# 1 = 允许任何人注册（第一个注册者是管理员）；默认只能凭邀请码加入
QAGENT_OPEN_REGISTRATION=0

# ---- 真实资金 ----
# 真实永续必须使用独立开关，不能复用微实盘开关。默认关闭。
QAGENT_REAL_PERP=0
# 服务器级急停文件（放在 QAGENT_HOME 下）：real_perp.KILL / microlive.KILL
# 生产中请用只读挂载或运维操作创建；存在时对应通道拒绝新开仓并平仓已运行实验。

# ---- LLM Provider（也可在“模型配置”页登记，登记后加密保存）----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# ---- 通知通道（长期 Agent）----
WECOM_WEBHOOK_URL=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=

# 交易所 Key 不再通过环境变量配置：个人只读账户请在“个人账户”页用向导绑定（按工作区隔离、独立加密）。

# 同一进程内对同一交易所的外部行情请求最小间隔（毫秒）；本地缓存命中不受影响
QAGENT_EXCHANGE_MIN_INTERVAL_MS=75

# 新工作区首次访问时写入通过平台审核的内置因子/模型/组合/策略（1=开启，0=关闭）
QAGENT_SEED_BUILTINS=1
